"NSCameraUsageDescription" = "கையெழுத்து வார்ப்புருவின் புகைப்படம் எடுக்கத் தேர்ந்தெடுத்தால் மட்டுமே கேமரா பயன்படுத்தப்படும்.";
"NSLocationWhenInUseUsageDescription" = "இருப்பிடம் பயன்படுத்தப்படுவதில்லை. புகைப்படத் தேர்வி நூலகம் API ஐ மட்டுமே குறிப்பிடுகிறது; செயலி அதை ஒருபோதும் கேட்பதில்லை.";
"NSPhotoLibraryAddUsageDescription" = "இந்தச் செயலி உங்கள் கையெழுத்து உரையின் படங்களை புகைப்பட நூலகத்தில் சேமிக்கிறது.";
"NSPhotoLibraryUsageDescription" = "சீரமைக்க கையெழுத்து வார்ப்புருவின் படத்தைத் தேர்ந்தெடுக்கும்போது மட்டுமே புகைப்படங்கள் படிக்கப்படும்.";
